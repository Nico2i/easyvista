{% extends 'base.html.twig' %}
{% set nav = 'mes-demandes' %}
{% block title %}{{ d ? d.t.number ~ ' · ' }}Mes demandes · {{ parent() }}{% endblock %}
{% set pills = {wait: 'En attente de validation', run: 'En cours de traitement', ok: 'Terminée'} %}

{% block body %}
<div class="sec-title"><h2>Mes demandes</h2><small>Problèmes signalés et demandes, au même endroit</small></div>
{% if error %}<div class="alert error" role="alert">{{ error }}</div>{% endif %}
<div class="filters" style="margin-bottom:12px">
    {% for k, label in {'en-cours': 'En cours', 'terminees': 'Terminées', 'toutes': 'Toutes'} %}
        <a class="fchip" href="{{ path('app_my_requests', {statut: k}) }}" aria-pressed="{{ filter == k ? 'true' : 'false' }}">{{ label }} <span class="count">{{ counts[k] }}</span></a>
    {% endfor %}
</div>
<div class="list" id="ticket-list">
    {% for t in tickets %}
        <a class="row tkrow" href="{{ path('app_ticket_show', {number: t.number, statut: filter}) }}" data-drawer="{{ path('app_ticket_show', {number: t.number, statut: filter}) }}" aria-current="{{ number == t.number ? 'true' : 'false' }}">
            <span class="t tk">
                <span class="num">{{ t.number }}</span>
                <span><span class="kind {{ t.isIncident ? 'p' : 'd' }}">{{ t.isIncident ? 'Problème' : 'Demande' }}</span>
                    <strong>{{ t.label }}</strong>
                    <small>{% if t.submittedAt %}Envoyée le {{ t.submittedAt|date('d/m/Y') }}{% endif %}{% if t.recipientName and t.recipientName != app.user.name %} · pour {{ t.recipientName }}{% endif %}</small></span>
                <span class="pill {{ t.status }}">{{ t.statusLabel ?: pills[t.status] }}</span>
            </span>
        </a>
    {% else %}
        <div class="empty">{{ filter == 'terminees' ? 'Aucune demande terminée.' : 'Aucune demande en cours.' }} <a href="{{ path('app_home') }}">Faire une demande</a></div>
    {% endfor %}
</div>

{# Panneau de détail : ouvert côté serveur si l'URL désigne une demande, sinon rempli par JavaScript #}
<div class="scrim {{ number ? 'open' }}" data-drawer-close></div>
<aside class="drawer {{ number ? 'open' }}" id="drawer" role="dialog" aria-modal="true" aria-labelledby="dr-title" aria-hidden="{{ number ? 'false' : 'true' }}" data-list-url="{{ path('app_my_requests', {statut: filter}) }}">
    {% if number %}{{ include('tickets/_drawer.html.twig') }}{% endif %}
</aside>
{% endblock %}
