{% extends 'base.html.twig' %}
{% block title %}{{ sent.number }} · {{ parent() }}{% endblock %}

{% block body %}
<div class="formcard"><div class="done">
    <span class="tick">{{ icon('check') }}</span>
    <h1>{{ sent.kind == 'p' ? 'Votre signalement est enregistré' : 'Votre demande est envoyée' }}</h1>
    <div class="ticket">{{ sent.number }}</div>
    <p style="max-width:52ch;margin:0">{{ sent.label }}.<br>
        {% if sent.kind == 'p' %}
            La hotline le traite du lundi au vendredi. Vous serez contacté·e si besoin.
        {% else %}
            {% if sent.validator %}Elle part en validation auprès de «&nbsp;{{ sent.validator }}&nbsp;». {% endif %}Vous suivez son avancement dans «&nbsp;Mes demandes&nbsp;».
        {% endif %}
    </p>
    {% if sent.attachmentFailed %}<div class="alert info">Votre pièce jointe n'a pas pu être transmise. Vous pourrez l'envoyer en répondant au courriel de prise en charge.</div>{% endif %}
    <div style="display:flex;gap:10px;flex-wrap:wrap;justify-content:center">
        <a class="btn" href="{{ path('app_my_requests', {rfc: sent.number, statut: 'toutes'}) }}">Voir mes demandes</a>
        <a class="btn primary" href="{{ path('app_home') }}">Retour à l'accueil</a>
    </div>
    {% if easyvista_simule %}<p class="help">Démonstration&nbsp;: rien n'a été transmis à EasyVista.</p>{% endif %}
</div></div>
{% endblock %}
