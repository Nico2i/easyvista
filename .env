# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> calipso ###
# mock : aucune connexion à EasyVista (démonstration, tests) ; api : appels réels à l'API REST
EASYVISTA_MODE=mock
# Adresse de l'API : https://{serveur}/api/v1/{compte}/  (le / final est important)
EASYVISTA_BASE_URI=https://tenant.easyvista.com/api/v1/40000/
# Authentification : jeton Bearer (prioritaire) ou compte de service en Basic
# À définir dans .env.local (jamais dans un fichier versionné)
EASYVISTA_TOKEN=
EASYVISTA_LOGIN=
EASYVISTA_PASSWORD=
EASYVISTA_VERIFY_SSL=1
EASYVISTA_LANG=fr
EASYVISTA_DEFAULT_INCIDENT_CODE=
EASYVISTA_GENERIC_REQUEST_CODE=
EASYVISTA_MESSAGE_ACTION_TYPE_ID=
# Lien vers une demande dans EasyVista, {rfc} = numéro (bouton « Ouvrir dans EasyVista » du panneau)
EASYVISTA_TICKET_URL=
# Variable serveur contenant le login Windows de l'agent (SSO IIS/Apache/proxy)
CALIPSO_SSO_SERVER_VAR=REMOTE_USER
# Login utilisé quand aucun SSO n'est présent (développement uniquement ; laisser vide en production)
CALIPSO_DEV_LOGIN=
CALIPSO_LEGACY_URL=
###< calipso ###
